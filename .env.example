# ==========================================================
# Kajian Salaf - Environment Variables (Docker & Production)
# ==========================================================

# Port Mapping Host VPS (Opsional)
BACKEND_PORT=8787
FRONTEND_PORT=3012
DB_HOST_PORT=5434

# Database Configuration (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=ganti_dengan_password_db_yang_kuat
DB_NAME=kajian_salaf
DB_SSLMODE=disable

# JWT Secret untuk Autentikasi Admin
JWT_SECRET=ganti_dengan_jwt_secret_acak_yang_panjang_dan_aman

# CORS Allowed Origins (pisahkan dengan koma jika lebih dari satu)
# Contoh: https://kajian-salaf.pages.dev,https://kajiansalaf.com
# Gunakan * untuk mengizinkan semua domain (default)
CORS_ORIGIN=*

# Cloudflare Tunnel Token (Opsional, jika menggunakan Cloudflare Tunnel)
# Dapatkan dari Cloudflare Zero Trust Dashboard -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...
